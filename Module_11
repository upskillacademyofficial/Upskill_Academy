# By using Spark.sql
# Create employee table using spark.sql

spark.sql("""
CREATE OR REPLACE TABLE employee (
    emp_id INT,
    emp_name STRING,
    department STRING,
    salary DOUBLE,
    city STRING
)
""")

# Insert records into employee table

spark.sql("""
INSERT INTO employee VALUES
(101, 'Rahul', 'IT', 55000, 'Pune'),
(102, 'Sneha', 'HR', 45000, 'Mumbai'),
(103, 'Amit', 'Finance', 60000, 'Delhi'),
