1.	Practical demo of auto loader

1. autoloader with rescue
# Data Reading
df = spark.readStream.format("cloudFiles")\
          .option("cloudFiles.format","csv")\
          .option("cloudFiles.schemaLocation","/Volumes/workspace/data_engineering/autovol/destination/checkpoint/")\
          .option("cloudFiles.schemaEvolutionMode","rescue")\
          .load("/Volumes/workspace/data_engineering/autovol/raw/")

# Data writting
df.writeStream.format("delta")\
        .outputMode("append")\
        .option("checkpointLocation","/Volumes/workspace/data_engineering/autovol/destination/checkpoint/")\
        .trigger(once=True)\
        .start("/Volumes/workspace/data_engineering/autovol/destination/data/")

# Once =True means trigger start processing data and it stop processing once job gets done.  we can also mention time like 5-10 sec

