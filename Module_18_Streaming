3. Schema Evolution with Autoloader - AddNewColumns
# Step 1
df = spark.readStream.format("cloudFiles")\
          .option("cloudFiles.format","csv")\
          .option("cloudFiles.schemaLocation","/Volumes/workspace/data_engineering/autovol/destination2/checkpoint/")\
          .option("cloudFiles.schemaEvolutionMode","addNewColumns")\
          .load("/Volumes/workspace/data_engineering/autovol/raw/")

# Step 2
df.writeStream.format("delta")\
        .outputMode("append")\
        .option("checkpointLocation","/Volumes/workspace/data_engineering/autovol/destination2/checkpoint/")\
        .trigger(once=True)\
        .option("mergeSchema", True)\
        .start("/Volumes/workspace/data_engineering/autovol/destination2/data/")

# Step 3- see the results
df_stream = spark.read.format("delta")\
            .load("/Volumes/workspace/data_engineering/autovol/destination2/data/")
display(df_stream)
