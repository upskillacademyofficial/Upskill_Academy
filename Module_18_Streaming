# Read the rescued_data which is of json using below query
from pyspark.sql.functions import * 
from pyspark.sql.types import *

rescued_schema = StructType() \
    .add("discount", StringType()) \
    .add("payment_method", StringType())

# Parse the stringified JSON column
df_stream = df_stream.withColumn("rescued_struct", from_json(col("_rescued_data"), rescued_schema))

# Extract individual fields
df_stream = df_stream.withColumn("rescued_discount", col("rescued_struct.discount")) \
       .withColumn("rescued_payment_method", col("rescued_struct.payment_method"))

display(df_stream)
